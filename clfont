# ---------------------------------------------------------------- 日志与输出

class Log:
    def __init__(self):
        self.f = None

    def open(self, cmd_name):
        try:
            LOG_DIR.mkdir(parents=True, exist_ok=True)
            path = LOG_DIR / f"clfont-{time.strftime('%Y%m%d-%H%M%S')}-{cmd_name}.log"
            self.f = open(path, "a", encoding="utf-8")
            self.path = path
            self.raw(f"=== clfont {cmd_name} · {time.strftime('%F %T')} · "
                     f"app={APP} · argv={sys.argv[1:]} ===")
        except OSError as e:
            print(f"  ! 无法打开日志（继续执行）：{e}")

    def raw(self, line):
        if self.f:
            try:
                self.f.write(f"[{time.strftime('%T')}] {line}\n")
                self.f.flush()
                os.fsync(self.f.fileno())
            except OSError:
                pass


L = Log()


def _emit(prefix, msg):
    print(f"{prefix}{msg}")
    L.raw(f"{prefix.strip() or '·'} {msg}")


def ok(msg):    _emit("  ✓ ", msg)
def bad(msg):   _emit("  ✗ ", msg)
def info(msg):  _emit("  · ", msg)
def step(msg):  _emit("\n▸ ", msg)


def die(msg, code=1):
    _emit("\n✗ 失败：", msg)
    sys.exit(code)


def confirm(prompt, assume_yes=False):
    if assume_yes:
        print(f"{prompt} [y/N] y（--yes）")
        L.raw(f"confirm auto-yes: {prompt}")
        return True
    try:
        ans = input(f"{prompt} [y/N] ").strip().lower()
    except EOFError:
        ans = ""
    L.raw(f"confirm: {prompt} -> {ans!r}")
    return ans in ("y", "yes")


def run_cmd(cmd, check=True):
    L.raw("$ " + " ".join(map(str, cmd)))
    r = subprocess.run(list(map(str, cmd)), capture_output=True, text=True)
    if r.stdout.strip():
        L.raw("stdout: " + r.stdout.strip()[:2000])
    if r.stderr.strip():
        L.raw("stderr: " + r.stderr.strip()[:2000])
    L.raw(f"exit={r.returncode}")
    if check and r.returncode != 0:
        raise RuntimeError(
            f"命令失败（exit {r.returncode}）：{' '.join(map(str, cmd))}"
            f"\n    {r.stderr.strip()[:500]}")
    return r


# ---------------------------------------------------------------- 测试崩溃钩子

def maybe_crash(tag):
    spec = os.environ.get("CLFONT_CRASH_AT", "")
    if not spec:
        return
    want, _, kind = spec.partition(":")
    if want != tag:
        return
    L.raw(f"CRASH HOOK triggered: {spec}")
    if kind == "int":
        raise KeyboardInterrupt(f"测试钩子 {tag}")
    print(f"  !! 测试钩子：SIGKILL @ {tag}")
    os.kill(os.getpid(), signal.SIGKILL)


# ---------------------------------------------------------------- 事务日志（journal）

def journal_write(data):
    try:
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        tmp = JOURNAL.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(data, ensure_ascii=False, indent=1))
        tmp.rename(JOURNAL)
    except OSError as e:
        L.raw(f"journal 写入失败：{e}")


def journal_read():
    try:
        return json.loads(JOURNAL.read_text()) if JOURNAL.exists() else None
    except (OSError, json.JSONDecodeError):
        return {"corrupt": True}


def journal_clear():
    try:
        JOURNAL.unlink(missing_ok=True)
    except OSError:
        pass


class Txn:
    """事务：mark() 记录进度到 journal，add_undo() 入栈；rollback() 逆序撤销，
    收尾一律重签 + 验证。"""

    def __init__(self, name):
        self.name = name
        self.steps = []
        self.undo = []
        journal_write(self._state("started"))

    def _state(self, status):
        return {"txn": self.name, "app": str(APP), "status": status,
                "time": time.strftime("%F %T"), "steps": self.steps,
                "log": str(getattr(L, "path", ""))}

    def mark(self, desc, done=True):
        self.steps.append({"step": desc, "done": done,
                           "time": time.strftime("%T")})
        journal_write(self._state("in-progress"))
        L.raw(f"txn mark: {desc} done={done}")

    def add_undo(self, desc, fn):
        self.undo.append((desc, fn))

    def commit(self):
        journal_clear()
        L.raw("txn commit")

    def rollback(self):
        # 回滚期间屏蔽 Ctrl+C，避免二次中断留下半成品
        old = signal.signal(signal.SIGINT, signal.SIG_IGN)
        print("\n▸ 正在回滚（请勿再次中断）…")
        L.raw("txn rollback begin")
        journal_write(self._state("rolling-back"))
        failed = []
        for desc, fn in reversed(self.undo):
            try:
                fn()
                ok(f"已撤销：{desc}")
            except Exception as e:
                bad(f"撤销失败：{desc} —— {e}")
                failed.append(desc)
        # 收尾：无论如何重签 + 验证（resource seal 对目录结构敏感，
        # 即使文件已还原，签名也可能失效）
        try:
            resign()
        except Exception as e:
            bad(f"回滚收尾重签失败：{e}")
            failed.append("重签名")
        signal.signal(signal.SIGINT, old)
        if failed:
            journal_write(self._state("rollback-incomplete"))
            print("\n✗ 回滚未完全成功（失败项：" + "、".join(failed) + "）")
            print("  手动还原命令：\n" + manual_restore_text())
            return False
        journal_clear()
        print("\n✓ 已回滚到原始状态（签名已验证）。")
        return True


# ---------------------------------------------------------------- 配置

def load_config():
    cfg = dict(DEFAULT_CONFIG)
    if CONFIG_PATH.exists():
        try:
            cfg.update(json.loads(CONFIG_PATH.read_text()))
        except (json.JSONDecodeError, OSError) as e:
            info(f"配置文件损坏，忽略：{e}")
    return cfg


def save_config(cfg):
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n")


# 「上次打补丁的记录」必须按目标分开存：配置文件只有一份，正式版和测试副本
# 共用。旧版把它记在 cfg["last_install"] 里，给测试副本打一次补丁就会覆盖掉
# 正式版的记录，「Claude 更新后补丁失效」的提醒也就跟着失灵。

def _target_key():
    return target_slug() or "default"


def last_install_get(cfg):
    per = cfg.get("last_install_targets")
    if isinstance(per, dict) and _target_key() in per:
        return per[_target_key()] or {}
    legacy = cfg.get("last_install")     # 旧版本留下的单份记录，只算默认目标的
    if isinstance(legacy, dict) and not target_slug():
        return legacy
    return {}


def last_install_set(cfg, rec):
    per = cfg.get("last_install_targets")
    cfg["last_install_targets"] = {**(per if isinstance(per, dict) else {}),
                                   _target_key(): rec}
    cfg.pop("last_install", None)


def last_install_clear(cfg):
    per = cfg.get("last_install_targets")
    changed = False
    if isinstance(per, dict) and per.pop(_target_key(), None) is not None:
        cfg["last_install_targets"] = per
        changed = True
    if not target_slug() and cfg.pop("last_install", None) is not None:
        changed = True
    return changed


# ---------------------------------------------------------------- 基础探查

def claude_version():
    try:
        with open(INFO_PLIST, "rb") as f:
            return plistlib.load(f).get("CFBundleShortVersionString", "?")
    except (OSError, plistlib.InvalidFileException):
        return None


def claude_pids():
    """注意：pgrep 在部分环境下匹配不到 Claude 主进程，用 ps 按完整路径匹配。"""
    r = subprocess.run(["ps", "-axo", "pid=,comm="], capture_output=True, text=True)
    pids = []
    for line in r.stdout.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) == 2 and parts[1] == str(BINARY):
            pids.append(int(parts[0]))
    return pids


def claude_running():
    return bool(claude_pids())


def quit_claude(assume_yes):
    if not claude_running():
        return True
    print("  ! Claude 正在运行，操作前必须退出。")
    if not confirm("    是否代为退出 Claude？", assume_yes):
        return False
    # 只对「本次目标 app」的进程发信号。绝不能用
    # osascript -e 'tell application "Claude" to quit'：AppleScript 按应用名
    # 解析，会退掉正在运行的那个 Claude（通常是 /Applications 里的正式版），
    # 而不是 --app 指定的副本——曾因此误退用户的正式 Claude。
    for pid in claude_pids():
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    for _ in range(20):
        if not claude_running():
            ok("Claude 已退出")
            return True
        time.sleep(0.5)
    for pid in claude_pids():
        subprocess.run(["kill", str(pid)])
    time.sleep(1)
    if claude_running():
        bad("无法退出 Claude，请手动退出后重试。")
        return False
    ok("Claude 已退出（kill）")
    return True


def is_patched():
    """asar 里的 preload 是否含注入标记。"""
    if not ASAR.exists():
        return False
    try:
        header, base = asar_read_header(ASAR)
    except (OSError, ValueError, json.JSONDecodeError):
        return False
    node = header
    for part in PRELOAD_REL.strip("/").split("/"):
        node = node.get("files", {}).get(part)
        if node is None:
            return False
    try:
        with open(ASAR, "rb") as f:
            f.seek(base + int(node["offset"]))
            return MARKER.encode() in f.read(int(node["size"]))
    except (OSError, KeyError, ValueError):
        return False


# ---------------------------------------------------------------- asar（纯 Python）
#
# Claude Desktop 开启了两个 Electron fuse（用 npx @electron/fuses read 可查）：
#   OnlyLoadAppFromAsar: Enabled              → 只能从 app.asar 加载，
#                                               「改名 asar + 解包成 app/ 目录」
#                                               这条老路已被硬性禁止（app 启动
#                                               即 exit=1，零输出）。
#   EnableEmbeddedAsarIntegrityValidation: Enabled
#                                             → asar header 的 SHA256 记录在
#                                               Info.plist 的 ElectronAsarIntegrity
#                                               里，改了 asar 必须同步更新它。
# 因此本工具改为「原地重打包 asar + 更新 Info.plist 哈希 + 重签」。
# 打包器经往返测试：原样重打与官方 asar 逐字节一致。

def asar_read_header(asar_path):
    with open(asar_path, "rb") as f:
        head = f.read(16)
        if len(head) < 16:
            raise ValueError("asar 文件过小")
        _, pickle_size, _, json_len = struct.unpack("<IIII", head)
        header = json.loads(f.read(json_len).decode("utf-8"))
    return header, 8 + pickle_size


def asar_integrity(buf, block_size=4194304):
    """按 Electron per-file integrity 规格计算：整体 SHA256 + 分块 SHA256。
    已对本机 asar 的 275 个打包文件（含 >4MB 多块文件）复算验证，全部一致。"""
    blocks = [hashlib.sha256(buf[i:i + block_size]).hexdigest()
              for i in range(0, len(buf), block_size)]
    if not blocks:
        blocks = [hashlib.sha256(b"").hexdigest()]
    return {"algorithm": "SHA256", "hash": hashlib.sha256(buf).hexdigest(),
            "blockSize": block_size, "blocks": blocks}


def asar_header_hash(asar_path):
    """Info.plist 里 ElectronAsarIntegrity 记录的就是 header JSON 的 SHA256。"""
    with open(asar_path, "rb") as f:
        _, _, _, json_len = struct.unpack("<IIII", f.read(16))
        return hashlib.sha256(f.read(json_len)).hexdigest()


def asar_pack(header, get_bytes, out_path):
    """按原 offset 顺序重写内容区并重算 offset/size。
    注意两个易错点（均已由往返测试验证）：
      1) pickle 头：inner = align4(4 + json_len)，outer = 4 + inner，
         写入 (4, outer, inner, json_len)。
      2) 内容去重：多个条目可共享同一 (offset,size)（如相同的 woff2），
         必须按块去重写一次，并让共享它的所有条目指向同一新 offset。"""
    blocks, order = {}, []

    def walk(node, rel):
        for name, entry in node.get("files", {}).items():
            sub = rel + "/" + name
            if "files" in entry:
                walk(entry, sub)
            elif "link" in entry or entry.get("unpacked"):
                continue
            else:
                key = (int(entry["offset"]), int(entry["size"]))
                if key not in blocks:
                    blocks[key] = []
                    order.append((key, sub))
                blocks[key].append(entry)
    walk(header, "")
    order.sort(key=lambda t: t[0][0])

    blobs, cursor = [], 0
    for key, sub in order:
        data = get_bytes(sub, key)
        changed = len(data) != key[1]
        if changed and len(blocks[key]) > 1:
            # 该内容块被多个条目共享，改它会殃及其它文件
            raise RuntimeError(f"拒绝修改被去重共享的内容块：{sub}")
        for entry in blocks[key]:
            entry["offset"] = str(cursor)
            entry["size"] = len(data)
            # 必须重算 per-file integrity：Electron 开了完整性校验，
            # 只更新 size 而留着旧哈希，文件一被加载就会校验失败。
            if "integrity" in entry:
                entry["integrity"] = asar_integrity(
                    data, entry["integrity"].get("blockSize", 4194304))
        blobs.append(data)
        cursor += len(data)

    hdr_json = json.dumps(header, separators=(",", ":"),
                          ensure_ascii=False).encode("utf-8")
    jl = len(hdr_json)
    inner = (4 + jl + 3) // 4 * 4
    outer = 4 + inner
    tmp = Path(str(out_path) + ".tmp")
    with open(tmp, "wb") as f:
        f.write(struct.pack("<IIII", 4, outer, inner, jl))
        f.write(hdr_json)
        f.write(b"\0" * (inner - 4 - jl))
        for b in blobs:
            f.write(b)
        f.flush()
        os.fsync(f.fileno())
    tmp.replace(out_path)


def plist_get_asar_hash():
    r = subprocess.run(
        ["/usr/libexec/PlistBuddy", "-c",
         "Print :ElectronAsarIntegrity:Resources/app.asar:hash", str(INFO_PLIST)],
        capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def plist_set_asar_hash(value):
    run_cmd(["/usr/libexec/PlistBuddy", "-c",
             f"Set :ElectronAsarIntegrity:Resources/app.asar:hash {value}",
             str(INFO_PLIST)])


# ---------------------------------------------------------------- CSS 构造
#
# 注入策略（第三轮重写，renderer 层，零主进程改动）：
#   聊天内容是远程 claude.ai，用与桌面壳同一套 CDS 设计令牌，字体走 CSS
#   变量 --font-anthropic-serif / --font-anthropic-sans（变量名从本地
#   bundle 已确认，非 CDP 探测，稳定可靠）。默认在这两个变量值最前面插入
#   "ClaudeCJKSerif"：因 @font-face 的 unicode-range 只覆盖 CJK 区段，
#   拉丁字符自然回退到原本的 anthropic 字体，中文变宋体，互不影响。
#   brute 模式（--mode brute）额外加一条全局兜底规则，用于万一变量名不
#   匹配的情况（代价：sans UI 的拉丁也会变 serif，属可接受的退化）。

# CDS 字体栈（从本地 .vite/renderer/*/assets/*.css 确认，claude.ai 同款）
CDS_SERIF = '"anthropic-serif", ui-serif, Georgia, "Times New Roman", serif'
CDS_SANS = ('"anthropic-sans", ui-sans-serif, -apple-system, BlinkMacSystemFont, '
            '"Segoe UI", sans-serif')


def _locs(names):
    seen, out = set(), []
    for n in names:
        if n and n not in seen:
            seen.add(n)
            out.append(f'local("{n}")')
    return ", ".join(out)


def _srcs(cfg, key="font"):
    """返回 (常规 src, 粗体 src)。GUI 选字体时会写入 <key>_regular /
    <key>_bold（该族常规/粗体面的 PostScript 名），这样粗体命中真实粗体面
    而不是系统合成加粗。key 为 font（中文）或 font_latin（英文）。"""
    name = cfg.get(key) or ""
    if not name:
        return "", ""
    fonts = [name]
    if key == "font":
        fonts += list(cfg.get("fallback_fonts", []))
    reg = cfg.get(key + "_regular")
    bold = cfg.get(key + "_bold")
    if key == "font" and not reg and not bold and name == "Songti SC":
        reg, bold = "STSongti-SC-Regular", "STSongti-SC-Bold"
    return _locs([reg] + fonts), _locs([bold or reg] + fonts)


SCALE_MIN, SCALE_MAX = 80, 150


def _scale(cfg, key):
    """字号缩放的百分比，落在 [80, 150]。

    实现用的是 @font-face 的 size-adjust，它只放大/缩小字形本身，不改任何
    CSS 里的 font-size 值。所以缩放严格限制在被我们替换掉的那些码位上——
    图标、没被替换的文字、整体布局的间距都不受牵连。这是它比「整页缩放」
    或 `*{font-size:...}` 干净得多的地方。"""
    try:
        v = int(round(float(cfg.get(key, 100))))
    except (TypeError, ValueError):
        v = 100
    return max(SCALE_MIN, min(SCALE_MAX, v))


def size_adjust_css(scale):
    return f"size-adjust:{scale}%;" if scale != 100 else ""


def scope_specs(cfg):
    """按 scope 展开成 [(kind, 码位区间, 常规 src, 粗体 src, 字号百分比)]。
    kind 为 cjk / latin，决定该分组能否扩展到重音字母区。字体没填的分组跳过。"""
    scope = cfg.get("scope", "cjk")
    out = []
    if scope in ("cjk", "both"):
        reg, bold = _srcs(cfg, "font")
        if reg:
            out.append(("cjk", UNICODE_RANGE_CJK, reg, bold,
                        _scale(cfg, "font_scale")))
    if scope in ("latin", "both"):
        reg, bold = _srcs(cfg, "font_latin")
        if reg:
            out.append(("latin", UNICODE_RANGE_LATIN, reg, bold,
                        _scale(cfg, "font_scale_latin")))
    return out


CJK_FAMILY_BODY = "ClaudeCJKSerif"
CJK_FAMILY_UI = "ClaudeCJKSerifUI"
LATIN_FAMILY_BODY = "ClfontLatin"
LATIN_FAMILY_UI = "ClfontLatinUI"


def cjk_families(cfg):
    """中文替换用的族：(族名, 码位区间, 字号 key)。正文与界面各一份，
    除字号外完全相同——这样侧边栏、输入框的中文可以和正文用不同字号。"""
    if cfg.get("scope", "cjk") not in ("cjk", "both"):
        return []
    if not _srcs(cfg, "font")[0]:
        return []
    return [(CJK_FAMILY_BODY, UNICODE_RANGE, "font_scale"),
            (CJK_FAMILY_UI, UNICODE_RANGE, "font_scale_ui")]


def latin_families(cfg):
    """英文替换用的族。界面族不含重音区——图标就藏在 U+00C9 一带；
    「仅正文」时界面族整个跳过。"""
    if cfg.get("scope", "cjk") not in ("latin", "both"):
        return []
    if not _srcs(cfg, "font_latin")[0]:
        return []
    out = [(LATIN_FAMILY_BODY,
            UNICODE_RANGE_LATIN + ", " + UNICODE_RANGE_LATIN_EXT, "font_scale_latin")]
    if cfg.get("latin_scope") != "body":
        out.append((LATIN_FAMILY_UI, UNICODE_RANGE_LATIN, "font_scale_ui"))
    return out


def font_face_css(cfg):
    """替换用的自有族。

    **绝不给 anthropic-sans / anthropic-serif 追加 @font-face。** 往这两个已存在
    的 webfont 族里加声明，会让 Chromium 重建该族、把已经加载好的 webfont 打回
    unloaded 且不再取回；于是所有西文衬线掉到后备链里的 Georgia，数字变成旧式
    数字（4 7 9 下沉），一眼可见。2026-09-03 在测试副本上做过对照实测：注入前
    webfont=loaded、数字宽 259.63，注入后 webfont=unloaded、数字宽 251.97
    （= Georgia），且 15 秒后与显式 document.fonts.load() 之后都不恢复。
    替换一律走 vars_css() 的变量前插。"""
    out = []
    for fams, key in ((cjk_families(cfg), "font"), (latin_families(cfg), "font_latin")):
        if not fams:
            continue
        reg_src, bold_src = _srcs(cfg, key)
        for fam, rng, skey in fams:
            adj = size_adjust_css(_scale(cfg, skey))
            for style in ("normal", "italic"):
                # 按常规/粗体拆两段，免得粗体落回原字体走系统合成加粗。
                out.append(f'@font-face{{font-family:"{fam}";src:{reg_src};'
                           f'unicode-range:{rng};{adj}'
                           f'font-weight:100 500;font-style:{style};}}')
                out.append(f'@font-face{{font-family:"{fam}";src:{bold_src};'
                           f'unicode-range:{rng};{adj}'
                           f'font-weight:501 900;font-style:{style};}}')
    return "".join(out)


# Claude 正文/界面用的两个 webfont 家族（2026-08-31 在 claude.ai 实测确认）。
PAGE_FONT_FAMILIES = ("anthropic-sans", "anthropic-serif")

# brute 模式额外覆盖的常见具名字体族。注意只能列**具名**字体：
# sans-serif / serif / system-ui / ui-sans-serif / -apple-system 这些是 CSS
# 关键字，@font-face 不允许用它们当 family name，覆盖不了。
EXTRA_FONT_FAMILIES = (
    "Helvetica", "Helvetica Neue", "Arial", "Georgia", "Times", "Times New Roman",
    "Inter", "Roboto", "Segoe UI", "SF Pro", "SF Pro Text", "SF Pro Display",
    "PingFang SC", "PingFang TC", "Hiragino Sans GB", "Heiti SC",
    "Microsoft YaHei", "Noto Sans SC", "Noto Sans CJK SC", "Source Han Sans SC",
)


def face_override_css(cfg, families):
    """给**系统具名字体族**补一条只覆盖指定码位的 @font-face（仅 brute 模式用）。

    families 里绝不能出现 anthropic-sans / anthropic-serif：那两个是页面用
    url() 加载的 webfont 族，往里追加声明会把已加载的字体作废（见
    font_face_css 的说明）。系统字体族没有这个问题，它们本来就是本地字体。"""
    assert not set(families) & set(PAGE_FONT_FAMILIES), \
        "不能给页面自己的 webfont 族追加 @font-face"
    out = []
    body_only = cfg.get("latin_scope") == "body"
    ui_scale = _scale(cfg, "font_scale_ui")
    for kind, rng, reg_src, bold_src, scale in scope_specs(cfg):
        for fam in families:
            # 界面字体族走「界面字号」，正文族走中文/英文字号。
            # 侧边栏基准只有 13px，跟着正文一起放大时看不出变化，
            # 分开给一个数才调得动。
            adj = size_adjust_css(ui_scale if fam in ICON_BEARING_FAMILIES else scale)
            # 「仅正文」：界面字体族整个跳过。小字号的界面标签换成正文衬线体
            # 会显得单薄（Times 12pt 比 Helvetica 窄一成半），这个选项就是
            # 为此留的。
            if kind == "latin" and body_only and fam in ICON_BEARING_FAMILIES:
                continue
            # 正文字体可以连重音字母一起换；承载图标的界面字体不行
            frng = rng
            if kind == "latin" and fam not in ICON_BEARING_FAMILIES:
                frng = rng + ", " + UNICODE_RANGE_LATIN_EXT
            for style in ("normal", "italic"):
                # 页面自己的 face 声明的是可变字重 300 800，这里按常规/粗体拆
                # 两段，免得粗体落回原字体（那样又会走系统兜底）。
                out.append(f'@font-face{{font-family:"{fam}";src:{reg_src};'
                           f'unicode-range:{frng};{adj}'
                           f'font-weight:100 500;font-style:{style};}}')
                out.append(f'@font-face{{font-family:"{fam}";src:{bold_src};'
                           f'unicode-range:{frng};{adj}'
                           f'font-weight:501 900;font-style:{style};}}')
    return "".join(out)


HEX_RE = re.compile(r"^#[0-9A-Fa-f]{6}$")

# 底色的最低对比度。我们只改背景、不改文字色，而正文色接近纯黑，选到深色就
# 不是「不好看」而是「读不了」——实测深灰 #555555 与正文的对比度只有 2.6，
# 纯黑 1.1。7.0 是 WCAG 的 AAA 门槛，浅色底轻松满足，中灰以下会被挡住。
MIN_BG_CONTRAST = 7.0
PAGE_TEXT_RGB = (11, 11, 11)     # 页面正文色，来自 CDS 的 --gray-900


def _relative_luminance(rgb):
    def ch(v):
        v /= 255
        return v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4
    r, g, b = (ch(c) for c in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast_ratio(a, b):
    la, lb = sorted((_relative_luminance(a), _relative_luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def bg_readable(hex_color):
    """底色是否够浅，能让原有的深色正文读得清。"""
    rgb = tuple(int(hex_color[i:i + 2], 16) for i in (1, 3, 5))
    return contrast_ratio(rgb, PAGE_TEXT_RGB) >= MIN_BG_CONTRAST


def background_css(cfg):
    """页面底色。

    改的是 CDS 的 surface 语义 token，不去动底层色阶——分隔线、边框也在用那些，
    一起改会牵连出一堆对比度问题。层次关系保留原设计：surface-0 最深（页面），
    往上逐级混向白色（卡片、浮层最浅）。

    两个必要条件，都是实测得出的，改动前请先复现：
    1. 变量名必须带 --cds- 前缀（见上方说明）；
    2. 必须加 !important。这些 token 会被页面后加载的样式表重新声明，普通声明
       会被赢回去——实测不加时计算值纹丝不动。

    只在浅色模式生效。包内文档原话：暗色模式是 :root 上的 [data-mode="dark"]，
    没有该属性时跟随 prefers-color-scheme。两条规则合起来覆盖「显式浅色」和
    「未声明且系统为浅色」；显式深色一律不碰。"""
    color = (cfg.get("bg_color") or "").strip()
    if not color:
        return ""
    if not HEX_RE.match(color):
        info(f"底色 {color!r} 不是 #RRGGBB 形式，已忽略")
        return ""
    if not bg_readable(color):
        info(f"底色 {color} 过深，正文将难以辨认（本工具不改文字颜色），已忽略。"
             "请选浅色。")
        return ""

    def mix(pct):
        # pct 为底色所占比例，其余混白；越靠上的层越浅
        return f"color-mix(in srgb, {color} {pct}%, #ffffff)"

    body = "".join(f"{v}:{val} !important;" for v, val in (
        ("--cds-surface-0", color),
        ("--cds-page-bg", color),
        ("--background-color-page", color),
        ("--cds-surface-1", mix(92)),
        ("--cds-surface-2", mix(85)),
        ("--cds-surface-3", mix(85)),
        ("--cds-surface-panel", mix(85)),
        ("--cds-surface-popover", mix(85)),
    ))
    return (
        f':root[data-mode="light"],.cds-root[data-mode="light"]{{{body}}}'
        f'@media (prefers-color-scheme: light){{'
        f':root:not([data-mode="dark"]),.cds-root:not([data-mode="dark"]){{{body}}}}}'
    )


CLFONT_MONO_FAMILY = "ClfontMono"

# 远程 claude.ai 页面用的是 CDS 的 .cds-root 作用域版本，变量名带 --cds- 前缀
# （html 元素上就挂着 class="cds-root"）。本地应用外壳里那份无前缀的 :root 导出
# 是另一套，改它对界面没有任何影响——这一点是实测出来的，别再改回去。
CDS_MONO_VAR = "--cds-font-mono"
CDS_SURFACE_VARS = ("--cds-surface-0", "--cds-surface-1", "--cds-surface-2",
                    "--cds-surface-3", "--cds-surface-panel",
                    "--cds-surface-popover", "--cds-page-bg",
                    "--background-color-page")


def mono_css(cfg):
    """代码块字体。

    先用 @font-face 定义我们自己的族（字号才有地方落，走 size-adjust），
    再把 --cds-font-mono 指向它，并保留原有的 ui-monospace 兜底链。

    必须带 !important：这些 token 会被页面后加载的样式表重新声明，不加就会被
    赢回去（实测：不加 !important 时 --cds-font-mono 保持原值不动）。"""
    name = (cfg.get("font_mono") or "").strip()
    if not name:
        return ""
    reg, bold = _srcs(cfg, "font_mono")
    if not reg:
        return ""
    adj = size_adjust_css(_scale(cfg, "font_mono_scale"))
    fam = CLFONT_MONO_FAMILY
    stack = f'"{fam}", ui-monospace, SFMono-Regular, Menlo, monospace'
    return (
        f'@font-face{{font-family:"{fam}";src:{reg};font-weight:100 500;{adj}}}'
        f'@font-face{{font-family:"{fam}";src:{bold};font-weight:501 900;{adj}}}'
        f':root,.cds-root{{{CDS_MONO_VAR}:{stack} !important;}}'
    )


def vars_css(cfg):
    """把我们自己的族前插到 CDS 字体变量。这是唯一的替换手段：既不改
    font-family（侧边栏图标就是 anthropic-sans 里的字形，一改就成豆腐块），
    也不碰 anthropic-* 这两个族本身（见 font_face_css 的说明）。
    各族的 unicode-range 互不重叠，所以前插的顺序无关紧要。"""
    serif, sans = [], []
    for fam, _rng, _key in cjk_families(cfg) + latin_families(cfg):
        (sans if fam in (CJK_FAMILY_UI, LATIN_FAMILY_UI) else serif).append(fam)
    if not serif and not sans:
        return ""
    decl = ""
    if serif:
        names = ", ".join(f'"{f}"' for f in serif)
        decl += f"--font-anthropic-serif:{names}, {CDS_SERIF} !important;"
    if sans:
        names = ", ".join(f'"{f}"' for f in sans)
        decl += f"--font-anthropic-sans:{names}, {CDS_SANS} !important;"
    return ":root{" + decl + "}"


def brute_css(cfg):
    """兜底：把 CJK 覆盖扩大到 EXTRA_FONT_FAMILIES 里的常见具名字体族。

    2026-08-31 起不再用 `*{font-family:...!important}` 那种全局覆盖：
    Claude 侧边栏的图标是某个图标字体的字形，一旦覆盖 font-family 就会
    全变成豆腐块，而且那个字体的名字我们并不知道，靠 :not() 排除是治不好的。
    改成只多补几条 @font-face、始终不碰 font-family 之后，图标不可能被波及。
    代价：`system-ui` / `-apple-system` / `sans-serif` 这类 CSS 关键字覆盖
    不了（@font-face 不接受关键字当 family name），那些地方的中文仍走系统字体。"""
    return face_override_css(cfg, EXTRA_FONT_FAMILIES)


def build_css(mode, cfg):
    scope = cfg.get("scope", "cjk")
    parts = [f"/* {MARKER} mode={mode} scope={scope} */"]
    parts.append(font_face_css(cfg))
    parts.append(vars_css(cfg))
    parts.append(mono_css(cfg))
    parts.append(background_css(cfg))
    if mode == "brute":
        parts.append(brute_css(cfg))
    css = " ".join(p for p in parts if p)
    assert "`" not in css and "${" not in css and "\\" not in css
    return css


def build_preload_injection(css):
    """构造追加到 preload(mainView.js) 尾部的自包含 IIFE：把上面 CSS 作为
    <style> 塞进远程页面的 DOM，并**始终保持在 head 末尾**。

    为什么要保持在末尾：同名家族有多条 @font-face 时，重叠码位上后声明的胜出。
    claude.ai 是 SPA，会在运行中懒加载 CSS chunk，那些 chunk 里同样声明了
    anthropic-sans/serif。如果只插一次就不管，后来的声明会把我们在**拉丁码位**
    上的覆盖赢回去（中文不受影响，因为它们的字体本来就没有中文字形——这正是
    「中文生效、英文不生效」和「思考过程文本有时候不变」的原因）。

    全程 try/catch，绝不可能让 preload 抛错；CSS 以 base64 携带，杜绝任何
    引号/反引号转义问题。"""
    b64 = base64.b64encode(css.encode("utf-8")).decode("ascii")
    return (
        f'\n;/* {MARKER} */(function(){{try{{'
        f'var B="{b64}";'
        'var CSS=(function(){try{var s=atob(B),a=new Uint8Array(s.length);'
        'for(var i=0;i<s.length;i++)a[i]=s.charCodeAt(i);'
        "return new TextDecoder('utf-8').decode(a);}catch(e){return atob(B);}})();"
        f'var ID="{MARKER}";var st=null,ob=null;'
        'function ensure(){try{if(typeof document==="undefined")return;'
        'var r=document.head||document.documentElement;if(!r)return;'
        'if(!st||!st.isConnected){st=document.getElementById(ID);}'
        'if(!st){st=document.createElement("style");st.id=ID;'
        'st.setAttribute("data-clfont","1");st.textContent=CSS;}'
        # 已经在末尾就什么都不做；否则移到末尾。移动本身会再触发一次观察器
        # 回调，那次检查会发现已在末尾而停下，不会形成死循环。
        'if(r.lastElementChild!==st)r.appendChild(st);'
        'if(!ob&&typeof MutationObserver!=="undefined"){'
        'ob=new MutationObserver(function(){ensure();});'
        'ob.observe(r,{childList:true});}}'
        'catch(e){}}'
        'ensure();'
        'try{if(typeof document!=="undefined"&&document.addEventListener){'
        'document.addEventListener("DOMContentLoaded",ensure);'
        'document.addEventListener("load",ensure,true);}}catch(e){}'
        'try{if(typeof setInterval!=="undefined"){var n=0;var t=setInterval(function(){'
        'ensure();if(++n>40&&t){clearInterval(t);t=null;}},500);}}catch(e){}'
        '}catch(e){}})();\n'
    )


# ---------------------------------------------------------------- 打补丁
#
# 只改 renderer 层，主进程（package.json 的 main = .vite/build/index.pre.js
# 及其 require 的 index*.chunk-*.js）一个字节都不碰。

# 加载 claude.ai 视图的 preload（webPreferences.preload 指向）。它运行在
# renderer 隔离世界、能触达远程聊天 DOM，且不含任何主进程 API。
PRELOAD_REL = "/.vite/build/mainView.js"
# 本地壳窗口的 HTML（只承载标题栏，聊天内容是远程的）——顺带打，属兜底
HTML_REL = "/.vite/renderer/main_window/index.html"


def _is_renderer_preload(data):
    """粗校验：像 preload（有 ipcRenderer/contextBridge），且不含主进程特征。
    主进程入口是 package.json 的 main（.vite/build/index.pre.js），绝不能碰。"""
    looks_preload = (b"ipcRenderer" in data) or (b"contextBridge" in data)
    main_markers = (b"app.whenReady", b"new BrowserWindow", b"app.on(")
    looks_main = any(mk in data for mk in main_markers)
    return looks_preload and not looks_main


def patch_asar(src_asar, out_asar, css):
    """读原 asar，仅改 renderer 层文件，重打包到 out_asar。
    主进程文件（index.pre.js 及其 require 的 chunk）原样透传。"""
    header, base = asar_read_header(src_asar)
    injection = build_preload_injection(css).encode("utf-8")
    style = f"<style>/* {MARKER} */ {css}</style>".encode("utf-8")
    patched, seen = [], set()

    fsrc = open(src_asar, "rb")
    try:
        def get(sub, key):
            off, size = key
            fsrc.seek(base + off)
            data = fsrc.read(size)
            if sub == PRELOAD_REL:
                if MARKER.encode() in data:
                    raise RuntimeError("preload 已含 clfont 注入（应先还原）")
                if not _is_renderer_preload(data):
                    raise RuntimeError(
                        f"{PRELOAD_REL} 看起来不是 renderer preload"
                        "（含主进程特征或缺少 ipcRenderer/contextBridge），"
                        "为避免误伤主进程，中止。")
                seen.add(sub)
                patched.append(sub)
                return data + injection
            if sub == HTML_REL and b"</head>" in data:
                seen.add(sub)
                patched.append(sub)
                return data.replace(b"</head>", style + b"\n</head>", 1)
            return data

        asar_pack(header, get, out_asar)
    finally:
        fsrc.close()

    if PRELOAD_REL not in seen:
        raise RuntimeError(
            f"未在 asar 中找到 preload {PRELOAD_REL}（Claude 结构可能已变化），"
            "无法影响远程聊天页面，中止。")
    return patched


# ---------------------------------------------------------------- 签名

def codesign_available():
    """确认 codesign 可用后再动 app：回滚同样要重签，等到那时才发现不可用，
    会留下一个签不上名、起不来的 Claude。

    注：codesign 本身是系统自带的真二进制，并不随 Xcode 命令行工具安装，
    所以这道检查通常都会通过；真正依赖 CLT 的是运行本脚本的 python3
    （/usr/bin/python3 只是 xcrun 转发壳），那道检查在 GUI 层。"""
    exe = shutil.which("codesign")
    if not exe:
        return False, "系统里找不到 codesign"
    # codesign 没有 --version；不带参数跑一下，真家伙会打印用法，
    # CLT 占位 shim 则会打印 xcode-select 的提示并请求安装。
    try:
        r = subprocess.run([exe], capture_output=True, text=True, timeout=30)
    except Exception as e:
        return False, f"codesign 无法运行（{e}）"
    out = (r.stdout or "") + (r.stderr or "")
    if "Usage: codesign" in out:
        return True, exe
    first = (out.strip().splitlines() or [""])[0]
    return False, first or f"codesign 退出码 {r.returncode}"


APP_MGMT_HINT = (
    "需要「App 管理」权限才能修改 Claude。\n"
    "    请打开「系统设置 → 隐私与安全性 → App 管理」，为 Clfont 打开开关，"
    "然后重新执行。\n"
    "    （从终端运行时，需要为「终端」打开该开关。）")


def app_write_permitted():
    """探测能否写目标 app —— macOS 的「App 管理」权限（TCC）。

    第一次尝试修改别的 app 时系统会弹窗询问，选了「不允许」之后就只剩 EPERM。
    与其等备份跑完一分钟、改到一半才失败，不如一开始就用一次无害的写操作探路。

    探测方式是把 Info.plist 的时间戳原样写回：这是一次真正的修改操作，会经过
    同一道 TCC 检查，但文件内容与元数据都不变，代码签名也不受影响（签名封的是
    内容，不是 mtime）。

    这只是提前量，不是唯一防线——万一某天 utimes 不再触发这道检查，探测会
    误判为通过，随后真正的写操作仍会拿到 EPERM，那里同样会给出这段提示。"""
    try:
        st = INFO_PLIST.stat()
        os.utime(INFO_PLIST, (st.st_atime, st.st_mtime))
        return True, ""
    except PermissionError as e:
        return False, str(e)
    except OSError as e:
        return False, str(e)


def require_app_write():
    good, detail = app_write_permitted()
    if good:
        return
    die(f"{APP_MGMT_HINT}\n    （系统返回：{detail}）\n"
        "    此刻尚未对 Claude 做任何修改。")


def require_codesign():
    good, detail = codesign_available()
    if good:
        return
    die("需要 Xcode 命令行工具（codesign）才能给 Claude 重新签名。\n"
        f"    {detail}\n"
        "    请先运行：xcode-select --install\n"
        "    装好后重试。（此刻尚未对 Claude 做任何修改。）")


def signing_team():
    """返回 app 的 TeamIdentifier；ad-hoc 签名返回 None。"""
    r = subprocess.run(["codesign", "-dv", str(APP)],
                       capture_output=True, text=True)
    out = (r.stderr or "") + (r.stdout or "")
    for line in out.splitlines():
        if line.startswith("TeamIdentifier="):
            v = line.split("=", 1)[1].strip()
            return None if v in ("", "not set") else v
    return None


def is_adhoc_signed():
    r = subprocess.run(["codesign", "-dv", str(APP)],
                       capture_output=True, text=True)
    return "adhoc" in ((r.stderr or "") + (r.stdout or ""))


# ----------------------------------------------- entitlements

# 与开发者身份绑定的 entitlement。ad-hoc 签名既没有 team 也没有描述文件，
# 这些项留着不会生效，反而可能让 AMFI 连整份 entitlement 一起拒掉。
ENT_DROP = {"com.apple.application-identifier", "keychain-access-groups"}
ENT_DROP_PREFIX = ("com.apple.developer.",)

HELPER_REL = "Contents/Frameworks/Claude Helper.app"


def read_entitlements(app_path):
    """读某个 .app 的 entitlements；读不到、为空、解析失败一律返回 None。"""
    r = subprocess.run(
        ["codesign", "-d", "--entitlements", "-", "--xml", str(app_path)],
        capture_output=True)
    if r.returncode != 0 or not (r.stdout or b"").strip():
        return None
    try:
        d = plistlib.loads(r.stdout)
    except Exception:
        return None
    return d if isinstance(d, dict) and d else None


def entitlements_path(version):
    return DATA_DIR / f"entitlements-{version}{target_slug()}.plist"


def capture_entitlements():
    """把原版 app 的 entitlements 缓存下来，供之后每次重签名带回去。

    必须赶在第一次改签名之前取——ad-hoc 一旦覆盖上去，原件就没了。
    已经被旧版 clfont 签成 ad-hoc 的机器，退而从整包备份里取。
    返回缓存文件路径；取不到返回 None。"""
    version = claude_version()
    if not version:
        return None
    dst = entitlements_path(version)
    if dst.exists():
        return dst
    src = APP if not is_adhoc_signed() else pristine_backup_for_current()
    ent = read_entitlements(src) if src else None
    if not ent:
        return None
    kept = {k: v for k, v in ent.items()
            if k not in ENT_DROP and not k.startswith(ENT_DROP_PREFIX)}
    dropped = sorted(set(ent) - set(kept))
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    dst.write_bytes(plistlib.dumps(kept))
    ok(f"已记录原版 entitlements（保留 {len(kept)} 项）：{dst.name}")
    if dropped:
        info("剔除与开发者身份绑定、ad-hoc 下无法生效的项：" + "、".join(dropped))
    return dst


def entitlements_for_resign():
    version = claude_version()
    if not version:
        return None
    p = entitlements_path(version)
    return p if p.exists() else capture_entitlements()


def nested_entitlements_stripped():
    """判断嵌套 Helper 的 entitlements 是否被抹掉过。

    v5.1 之前重签名用的是 codesign --deep，它会把每个 Helper 也重签成不带任何
    entitlement 的 ad-hoc。Claude Helper 因此丢掉 com.apple.security.virtualization
    等权限，Cowork/虚拟机功能失效。这种损伤无法就地补回，只能整包还原。"""
    helper = APP / HELPER_REL
    if not helper.exists():
        return False
    return read_entitlements(helper) is None


def pristine_backup_for_current():
    """当前已安装版本对应的整包备份（打补丁前留的原版，签名是 Anthropic 的）。"""
    v = claude_version()
    if not v:
        return None
    p = backup_path(v)
    return p if (p / "Contents/Info.plist").exists() else None


def sign_valid():
    return subprocess.run(["codesign", "-v", str(APP)],
                          capture_output=True).returncode == 0


def resign():
    """只重签顶层 bundle，并带回原版 entitlements。

    我们改的只有 Contents/Resources/app.asar 和 Contents/Info.plist，两者都由
    顶层签名封存，嵌套的 Helper / Framework 签名一个都没被破坏——所以不需要
    --deep。旧版用了 --deep，顺手把每个 Helper 重签成不带 entitlement 的
    ad-hoc，Claude Helper 丢掉 com.apple.security.virtualization，Cowork 与
    虚拟机功能随之失效。去掉 --deep 后 Helper 保持 Anthropic 原签名。

    也不加 --options runtime：顶层是 ad-hoc（无 team），而各 Framework 仍由
    Anthropic 签名；开启 hardened runtime 会一并打开库校验，团队不匹配将导致
    Electron Framework 加载失败。"""
    ent = entitlements_for_resign()
    info("重签名顶层 bundle（" +
         ("保留原版 entitlements" if ent else "未取到原版 entitlements，将不带") +
         "，整包较大需要一会儿；此阶段中断也会触发自动回滚）…")
    cmd = ["codesign", "--force", "--sign", "-"]
    if ent:
        cmd += ["--entitlements", str(ent)]
    run_cmd(cmd + [str(APP)])
    if not sign_valid():
        raise RuntimeError("codesign -v 验证未通过")
    ok("签名验证通过")


# ---------------------------------------------------------------- 冒烟测试

def smoke_test(timeout=20):
    """启动 app 验证「能活着起来」——事务 commit 的真正前提。
    第二轮事故：文件全绿但主进程静默退出（exit 0）。此测试专抓这种：
    直接 exec 主二进制，若它秒退或无进程存活即判失败 → 触发回滚。
    检测用 claude_pids()（按二进制路径），不用 pgrep（pgrep 匹配不到主进程）。
    CLFONT_SMOKE_USER_DATA_DIR 可指定独立 user-data-dir（测试副本用，避免与
    正在运行的正式 Claude 撞 single-instance 锁）。"""
    if os.environ.get("CLFONT_SMOKE_FORCE_FAIL"):
        L.raw("smoke FORCE_FAIL hook -> return False")
        info("测试钩子 CLFONT_SMOKE_FORCE_FAIL：强制判定冒烟失败")
        return False
    for pid in claude_pids():
        subprocess.run(["kill", str(pid)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(1)
    args = [str(BINARY)]
    udd = os.environ.get("CLFONT_SMOKE_USER_DATA_DIR")
    if udd:
        args += ["--user-data-dir", udd]
    info(f"启动 app，最多观察 {timeout}s，确认进程存活…")
    L.raw("smoke launch: " + " ".join(args))
    proc = subprocess.Popen(args, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL)
    alive = False
    stable = 0
    deadline = time.time() + timeout
    try:
        while time.time() < deadline:
            time.sleep(1.5)
            ec = proc.poll()
            pids = claude_pids()
            if ec is not None and not pids:
                info(f"主进程已退出（exit={ec}）且无存活进程 —— 冒烟失败")
                L.raw(f"smoke fail: exited ec={ec}")
                break
            if pids:
                stable += 1
                if stable >= 4:   # ≈6s 持续存活
                    alive = True
                    break
    finally:
        # 无论成败，关闭本次启动的实例，避免残留/影响后续回滚或文件操作
        for pid in claude_pids():
            subprocess.run(["kill", str(pid)],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if proc.poll() is None:
            proc.terminate()
        time.sleep(2)
        for pid in claude_pids():
            subprocess.run(["kill", "-9", str(pid)],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(0.5)
    L.raw(f"smoke result: alive={alive}")
    return alive


# ---------------------------------------------------------------- 备份

def target_slug():
    """非默认目标（--app 指定的其它 Claude.app）在备份名里加一段路径哈希。
    否则多个目标共用 DATA_DIR 时会按版本号撞车——曾导致给测试副本还原时
    取到正式版的备份，把副本换成了正式版的身份。默认目标保持老命名不变，
    这样已有备份仍然认得出来。"""
    if str(APP) == "/Applications/Claude.app":
        return ""
    return "-" + hashlib.sha256(str(APP).encode()).hexdigest()[:8]


_SLUG_RE = re.compile(r"-[0-9a-f]{8}$")


def backup_path(version):
    return DATA_DIR / f"Claude-backup-{version}{target_slug()}.app"


def list_backups():
    """只列当前目标的备份，按新到旧。"""
    slug = target_slug()
    out = []
    for pth in DATA_DIR.glob("Claude-backup-*.app"):
        stem = pth.name[len("Claude-backup-"):-len(".app")]
        m = _SLUG_RE.search(stem)
        if slug:
            if m and m.group(0) == slug:
                out.append(pth)
        elif not m:
            out.append(pth)
    return sorted(out, key=lambda q: q.stat().st_mtime, reverse=True)


def make_backup(version):
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    dest = backup_path(version)
    if (dest / "Contents/Info.plist").exists():
        ok(f"当前版本 {version} 的备份已存在，跳过：{dest}")
        return
    free = shutil.disk_usage(Path.home()).free
    if free < 3 * 1024 ** 3:
        raise RuntimeError(f"磁盘剩余空间不足 3GB（{free / 1024**3:.1f}GB），中止")
    info(f"整包备份（约 1 分钟）：ditto {APP} {dest}")
    try:
        run_cmd(["ditto", str(APP), str(dest)])
    except Exception:
        shutil.rmtree(dest, ignore_errors=True)
        raise
    ok(f"已备份到 {dest}")
    backups = list_backups()
    for old in backups[KEEP_BACKUPS:]:
        info(f"清理旧备份：{old.name}")
        shutil.rmtree(old, ignore_errors=True)


# ---------------------------------------------------------------- 还原

def restore_pristine():
    """把 app 修回未打补丁状态（幂等，容忍任意半成品）：
    还原 asar → 同步 Info.plist 哈希 → 清理残留 → 按需重签 + 验证。"""
    changed = False
    # 清理旧机制/中途残留
    for stale in (APP_DIR, RES / "app.clfont-tmp"):
        if stale.exists():
            info(f"删除 {stale.name}/（旧机制残留）")
            shutil.rmtree(stale)
            changed = True
    for stale in (RES / "app.asar.clfont-new", RES / "app.asar.clfont-new.tmp"):
        if stale.exists():
            info(f"删除 {stale.name}")
            stale.unlink()
            changed = True

    if ASAR_BAK.exists():
        # bak 是打补丁前的原始 asar；若 asar 已被补丁替换则还原之
        if not ASAR.exists() or is_patched():
            info("恢复 app.asar.bak → app.asar")
            shutil.copy2(ASAR_BAK, ASAR)
            changed = True
        else:
            info("app.asar 未含补丁（可能已被更新覆盖），保留之")
        ASAR_BAK.unlink()
        changed = True
    if not ASAR.exists():
        raise RuntimeError("app.asar 与 app.asar.bak 均不存在，需从整包备份恢复")

    # 同步 Info.plist 完整性哈希到当前 asar（不同步则 app 起不来）
    want = asar_header_hash(ASAR)
    if plist_get_asar_hash() != want:
        info(f"同步 ElectronAsarIntegrity 哈希 → {want[:12]}…")
        plist_set_asar_hash(want)
        changed = True

    # 即使文件已还原，resource seal 也可能失效——验证不过就重签
    if changed or not sign_valid():
        resign()
    else:
        ok("签名验证通过（无需重签）")


def backup_size(path):
    """返回字节数。APFS 克隆的块是共享的，这里给的是逻辑大小，
    实际占盘只会更小，作为上限展示足够。"""
    r = subprocess.run(["du", "-sk", str(path)], capture_output=True, text=True)
    try:
        return int(r.stdout.split()[0]) * 1024
    except (ValueError, IndexError):
        return 0


def human_size(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.1f} {unit}" if unit not in ("B", "KB") else f"{n:.0f} {unit}"
        n /= 1024


def backup_version(path):
    """从备份目录名里取版本号：Claude-backup-<版本>[-<slug>].app"""
    stem = path.name[len("Claude-backup-"):-len(".app")]
    return _SLUG_RE.sub("", stem)


def all_backups():
    return sorted(DATA_DIR.glob("Claude-backup-*.app"),
                  key=lambda q: q.stat().st_mtime, reverse=True)


def cmd_backups(args):
    print(f"clfont backups（目标：{APP}）")
    cur = claude_version()
    items = list_backups()
    others = [b for b in all_backups() if b not in items]
    if not items and not others:
        info("没有任何整包备份。首次 install 时会自动创建。")
        return
    total = keep_bytes = drop_bytes = 0
    prunable = []
    for b in items:
        size = backup_size(b)
        total += size
        if backup_version(b) == cur:
            keep_bytes += size
            ok(f"{b.name}  {human_size(size)}  ← 与当前版本一致，"
               "还原时可连原始签名一起恢复，请勿删除")
        else:
            drop_bytes += size
            prunable.append(b)
            info(f"{b.name}  {human_size(size)}  ← 旧版本，已无法用于还原，可清理")
    # 目标换过路径后，旧路径的备份会成为孤儿：两个目标都列不到它，
    # 用户也就永远删不掉。--all 把它们一并显示出来。
    if others:
        osize = sum(backup_size(b) for b in others)
        if getattr(args, "all", False):
            total += osize
            for b in others:
                bsize = backup_size(b)
                drop_bytes += bsize
                prunable.append(b)
                info(f"{b.name}  {human_size(bsize)}  ← 属于其他目标（如测试 Claude）"
                     "或已不存在的目标")
        else:
            info(f"另有 {len(others)} 份属于其他目标的备份（{human_size(osize)}），"
                 "用 clfont backups --all 查看和清理")

    shown = len(items) + (len(others) if getattr(args, "all", False) else 0)
    info(f"合计 {human_size(total)}（{shown} 份），"
         f"其中 {len(prunable)} 份可清理，可释放 {human_size(drop_bytes)}")
    if getattr(args, "purge", False):
        # 删光当前目标的备份，包括与当前版本一致的那份。只在「彻底删掉这个
        # 目标」时才用得上（比如删除测试副本），平时不该走这条路。
        prunable = list(items) + (prunable if getattr(args, "all", False) else [])
        drop_bytes = sum(backup_size(b) for b in prunable)
        bad("--purge 会删掉包含当前版本在内的全部备份，"
            "该目标将无法再恢复原始签名。")
    elif not getattr(args, "prune", False):
        if prunable:
            info("清理：clfont backups --prune" + (" --all" if getattr(args, "all", False) else ""))
        return
    if not prunable:
        ok("没有可清理的备份。")
        return
    if getattr(args, "all", False):
        bad("注意：--all 会连其他目标的备份一起删。那些目标将失去"
            "「还原时恢复原始签名」的能力。")
    if not confirm(f"  删除这 {len(prunable)} 份备份？", args.yes):
        info("已取消。")
        return
    for b in prunable:
        shutil.rmtree(b, ignore_errors=True)
        ok(f"已删除 {b.name}")
    info(f"释放约 {human_size(drop_bytes)}")


def restore_from_backup(assume_yes, src=None):
    if src is None:
        backups = list_backups()
        if not backups:
            raise RuntimeError("没有 app.asar(.bak)，也没有整包备份。"
                               "请到 https://claude.ai/download 重新下载安装 Claude。")
        src = backups[0]
    print(f"  将从整包备份还原：{src}")
    print(f"  这会删除并替换整个 {APP}")
    if not confirm("  继续？", assume_yes):
        raise RuntimeError("用户取消")
    shutil.rmtree(APP)
    run_cmd(["ditto", str(src), str(APP)])
    # 备份里的 plist 哈希应与其 asar 自洽；不自洽则修正（否则 app 起不来）
    if ASAR.exists():
        want = asar_header_hash(ASAR)
        if plist_get_asar_hash() != want:
            info(f"修正备份的 ElectronAsarIntegrity 哈希 → {want[:12]}…")
            plist_set_asar_hash(want)
            resign()
            return
    if sign_valid():
        ok("签名验证通过")
    else:
        info("备份签名校验未通过，重新 ad-hoc 签名")
        resign()


# ---------------------------------------------------------------- 自安装

def ensure_self_installed():
    """install 前把自身落盘到固定位置，保证事后可自救。失败则拒绝继续。"""
    me = Path(__file__).resolve()
    try:
        if CANON.exists() and CANON.resolve() == me:
            ok(f"工具已在固定位置：{CANON}")
        else:
            CANON.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(me, CANON)
            os.chmod(CANON, 0o755)
            ok(f"已将自身安装到 {CANON}（供事后自救）")
    except OSError as e:
        raise RuntimeError(
            f"无法把工具复制到 {CANON}（{e}）。"
            "为保证失败时能自救，拒绝继续 install。") from e
    if str(CANON.parent) not in os.environ.get("PATH", "").split(":"):
        info(f"提示：{CANON.parent} 不在 PATH 中，自救时请用完整路径 {CANON}")


# ---------------------------------------------------------------- 子命令

def check_prev_txn():
    j = journal_read()
    if not j:
        return
    if j.get("corrupt"):
        info("发现损坏的事务日志，忽略")
        return
    bad(f"发现未完成的事务：{j.get('txn')} @ {j.get('time')}（{j.get('status')}），"
        f"app={j.get('app')}")
    info(f"事务步骤：{'; '.join(s['step'] for s in j.get('steps', []))}")
    if j.get("log"):
        info(f"详细日志：{j['log']}")


def heal_nested_signatures(assume_yes):
    """修复旧版 --deep 重签留下的损伤。

    Helper 的 entitlements 被抹掉后无法就地补回（补回去也签不出 Anthropic 的
    身份），唯一的办法是拿打补丁前的整包备份整体还原。备份自身也得是完好的，
    否则还原过去等于原地踏步。"""
    if not nested_entitlements_stripped():
        return
    bak = pristine_backup_for_current()
    if bak and read_entitlements(bak / HELPER_REL):
        step("修复旧版重签名留下的损伤（Helper 丢失 entitlements，"
             "会导致 Cowork、虚拟机等功能不可用）")
        info("这类损伤无法就地修补，需要从整包备份整体还原后再打补丁。")
        restore_from_backup(assume_yes, src=bak)
        ok("已还原到原版签名，继续打补丁")
    else:
        bad("检测到 Helper 缺少 entitlements（旧版重签名的后果），"
            "Cowork、虚拟机等功能可能不可用。")
        info("没有可用于修复的原版备份。如需彻底修复，"
             "请到 https://claude.ai/download 重新下载安装 Claude 后再运行本工具。")


def cmd_install(args):
    print(f"clfont install（目标：{APP}）")
    cfg = load_config()
    mode = args.mode or cfg.get("mode", "auto")
    if mode not in ("auto", "brute"):
        mode = "auto"
    if getattr(args, "scope", None):
        cfg["scope"] = args.scope
    if cfg.get("scope") not in ("cjk", "latin", "both"):
        cfg["scope"] = "cjk"
    if getattr(args, "scale", None) is not None:
        cfg["font_scale"] = args.scale
    if getattr(args, "scale_latin", None) is not None:
        cfg["font_scale_latin"] = args.scale_latin
    if getattr(args, "mono", None) is not None:
        cfg["font_mono"] = args.mono
    if getattr(args, "mono_scale", None) is not None:
        cfg["font_mono_scale"] = args.mono_scale
    if getattr(args, "bg", None) is not None:
        cfg["bg_color"] = args.bg
    if getattr(args, "latin_scope", None) is not None:
        cfg["latin_scope"] = args.latin_scope
    if getattr(args, "scale_ui", None) is not None:
        cfg["font_scale_ui"] = args.scale_ui
    if not (scope_specs(cfg) or mono_css(cfg) or background_css(cfg)):
        die("没有任何可应用的设置：scope=%s 对应的字体名为空，"
            "代码块字体与页面底色也都没设。" % cfg["scope"])

    step("准备")
    require_codesign()
    require_app_write()
    ensure_self_installed()
    version = claude_version()
    if version is None:
        die(f"未找到 {APP}")
    ok(f"Claude Desktop {version}")
    check_prev_txn()
    if not ASAR.exists() and not ASAR_BAK.exists():
        die("app.asar 与 app.asar.bak 均不存在，应用结构异常，中止。")
    if not quit_claude(args.yes):
        die("Claude 仍在运行", 2)

    heal_nested_signatures(args.yes)
    capture_entitlements()

    txn = Txn("install")
    try:
        # 幂等 / 清理任何残留：先修回原始状态
        if ASAR_BAK.exists() or APP_DIR.exists() or is_patched() or not sign_valid():
            step("检测到旧补丁或残留，先修回原始状态（幂等）")
            restore_pristine()
            txn.mark("清理旧补丁")

        step("整包备份")
        make_backup(version)
        txn.mark("备份")
        maybe_crash("after-backup")

        step("重打包 app.asar（只改 renderer preload，主进程零改动）")
        css = build_css(mode, cfg)
        staged = RES / "app.asar.clfont-new"
        txn.add_undo("删除临时 asar",
                     lambda: staged.unlink(missing_ok=True))
        patched = patch_asar(ASAR, staged, css)
        ok("已注入：" + "、".join(p.lstrip("/") for p in patched))
        new_hash = asar_header_hash(staged)
        txn.mark("重打包")
        maybe_crash("after-patch")

        step("上线补丁（备份原 asar → 替换 → 更新完整性哈希）")
        old_hash = plist_get_asar_hash()
        if not old_hash:
            raise RuntimeError("读不到 Info.plist 的 ElectronAsarIntegrity 哈希")
        txn.mark("即将替换 app.asar", done=False)
        shutil.copy2(ASAR, ASAR_BAK)          # 原 asar 留底，供轻量还原
        txn.add_undo("app.asar.bak 还原回 app.asar 并删除 bak",
                     lambda: (shutil.copy2(ASAR_BAK, ASAR), ASAR_BAK.unlink())
                     if ASAR_BAK.exists() else None)
        staged.replace(ASAR)
        txn.mark("app.asar 已替换")
        maybe_crash("after-move")

        txn.mark("即将更新 Info.plist 完整性哈希", done=False)
        plist_set_asar_hash(new_hash)
        txn.add_undo("Info.plist 哈希改回原值",
                     lambda: plist_set_asar_hash(old_hash))
        txn.mark("Info.plist 哈希已更新")
        ok(f"ElectronAsarIntegrity 哈希 {old_hash[:12]}… → {new_hash[:12]}…")
        maybe_crash("after-rename")

        step("重签名")
        maybe_crash("before-resign")
        resign()
        txn.mark("重签名并验证")

        # commit 的定义 = 「app 能活着起来」，不是「文件操作完成」
        step("启动冒烟测试（验证 app 能存活，失败即回滚）")
        maybe_crash("before-smoke")
        if not smoke_test():
            raise RuntimeError(
                "冒烟测试失败：打补丁后 app 无法存活。补丁已判定有害，回滚。")
        ok("app 启动并存活，冒烟测试通过")
        txn.mark("冒烟测试通过")

        txn.commit()
        last_install_set(cfg, {"version": version, "mode": mode,
                               "time": time.strftime("%F %T")})
        save_config(cfg)

        print(f"\n✓ 完成。注入方式：{mode}，替换范围：{cfg.get('scope', 'cjk')}，"
              f"中文字体：{cfg['font'] or '—'}，英文字体：{cfg.get('font_latin') or '—'}")
        print("  说明：")
        print("  · 重签后首次启动 Claude 可能要求重新登录/授权钥匙串"
              "（Claude Safe Storage），属预期行为。")
        print("  · 若聊天中文仍非宋体，运行 clfont install --mode brute 加兜底规则。")
        print("  · Claude 更新后补丁会失效，重跑 clfont install 即可。")
        print(f"  · 日志：{getattr(L, 'path', '-')}")
        if mode == "brute":
            print("  · 当前为 brute 兜底模式：CJK 覆盖已扩大到常见具名字体族，"
                  "不改任何 font-family，图标不受影响。")

    except BaseException as e:
        if isinstance(e, SystemExit):
            raise
        name = "用户中断" if isinstance(e, KeyboardInterrupt) else f"异常：{e}"
        print(f"\n✗ install 失败（{name}）")
        # 前面的探测只是提前量，真正的写操作仍可能撞上 TCC；这里补同一段指引
        if isinstance(e, PermissionError):
            print("  " + APP_MGMT_HINT.replace("\n    ", "\n  "))
        L.raw(f"install failed: {e!r}")
        txn.rollback()
        sys.exit(130 if isinstance(e, KeyboardInterrupt) else 1)
    finally:
        for stale in (RES / "app.asar.clfont-new",
                      RES / "app.asar.clfont-new.tmp"):
            try:
                stale.unlink(missing_ok=True)
            except OSError:
                pass


def cmd_uninstall(args):
    print(f"clfont uninstall（目标：{APP}）")
    if claude_version() is None:
        die(f"未找到 {APP}")
    require_codesign()
    require_app_write()
    check_prev_txn()
    if not quit_claude(args.yes):
        die("Claude 仍在运行", 2)
    # 光把 asar 还原回去是不够的：重签只能签成 ad-hoc，Anthropic 的开发者签名、
    # hardened runtime 和身份相关的 entitlement（keychain-access-groups 等）
    # 都回不来。整包备份里躺着的才是原封不动的原版，能还原就优先用它。
    backup = pristine_backup_for_current()
    adhoc = is_adhoc_signed()
    try:
        if not ASAR.exists() and not ASAR_BAK.exists():
            step("从整包备份还原")
            restore_from_backup(args.yes)
        elif (not APP_DIR.exists() and not ASAR_BAK.exists()
              and not is_patched() and sign_valid()
              and plist_get_asar_hash() == asar_header_hash(ASAR)
              and not (adhoc and backup)):
            print("\n✓ 未检测到补丁且签名/哈希有效，无需还原。")
            journal_clear()
            return
        elif backup is not None:
            step("从整包备份还原（连 Anthropic 原始签名一起恢复）")
            restore_from_backup(args.yes, src=backup)
        else:
            step("还原")
            restore_pristine()
        journal_clear()
        # 主动还原后就不该再提醒「补丁失效，去重新应用」了
        cfg = load_config()
        if last_install_clear(cfg):
            save_config(cfg)
        team = signing_team()
        if team:
            print(f"\n✓ 已完全还原，且恢复了原始签名（TeamIdentifier={team}）。")
        else:
            print("\n✓ 已完全还原（签名已验证）。")
            info("签名是 ad-hoc：Anthropic 的原始签名没能还原（没有当前版本的"
                 "整包备份，或备份本身就已经是重签过的）。要彻底恢复请到 "
                 "https://claude.ai/download 重新下载安装。")
    except KeyboardInterrupt:
        print("\n! 中断。可重跑 clfont uninstall（幂等），或手动执行：")
        print(manual_restore_text())
        sys.exit(130)
    except Exception as e:
        print(f"\n✗ 还原失败：{e}")
        print("  手动还原命令：\n" + manual_restore_text())
        sys.exit(1)


def cmd_css(args):
    cfg = load_config()
    for key, attr in (("scope", "scope"), ("mode", "mode"), ("font_scale", "scale"),
                      ("font_scale_latin", "scale_latin"), ("font_mono", "mono"),
                      ("font_mono_scale", "mono_scale"), ("bg_color", "bg"),
                      ("latin_scope", "latin_scope"), ("font_scale_ui", "scale_ui")):
        v = getattr(args, attr, None)
        if v is not None:
            cfg[key] = v
    sys.stdout.write(build_css(cfg.get("mode", "auto"), cfg))


def cmd_status(_args):
    cfg = load_config()
    version = claude_version()
    print(f"clfont status（目标：{APP}）")
    if version is None:
        bad(f"未找到 {APP}")
        sys.exit(1)
    info(f"Claude 版本：{version}")
    check_prev_txn()

    patched = is_patched()
    last = last_install_get(cfg)
    if patched:
        desc = f"（{last.get('mode', '?')} 模式，{last.get('time', '?')}）" if last else ""
        ok(f"已打补丁 {desc}")
    else:
        info("未打补丁")
    # 上次打补丁时的 Claude 版本与现在对不上 = Claude 自己更新过，补丁随
    # app.asar 一起被覆盖掉了。主动还原（uninstall）会清掉 last_install，
    # 所以不会在这里误报。
    # 这一行是 GUI 判断「需要提醒用户重新应用」的依据，措辞改动需同步 GUI。
    if last.get("version") and last["version"] != version:
        bad(f"补丁已失效：Claude 已更新到 {version}"
            f"（上次应用于 {last['version']}），需要重新应用一次")
    info(f"app.asar：{'存在' if ASAR.exists() else '不存在'}"
         f"，app.asar.bak（原版留底）：{'存在' if ASAR_BAK.exists() else '不存在'}")
    if ASAR.exists():
        want, got = asar_header_hash(ASAR), plist_get_asar_hash()
        info(f"asar 完整性哈希：{'匹配' if want == got else '不匹配！app 将无法启动'}")
    info(f"codesign -v：{'通过' if sign_valid() else '未通过！'}")
    if nested_entitlements_stripped():
        bad("Helper 权限：缺失（旧版重签名的后果，Cowork/虚拟机等功能可能不可用；"
            "重新应用一次即会自动修复）")
    else:
        info("Helper 权限：完整")

    backups = list_backups()
    info("整包备份：" + ("、".join(b.name for b in backups) if backups else "无"))
    info(f"工具固定位置：{CANON}{'（已安装）' if CANON.exists() else '（未安装，install 时会自动复制）'}")
    # 字号只在非 100% 时才写出来：GUI 拿这一行里的字体名做标题，
    # 常态下多一个「（100%）」纯属噪声。
    def fmt(name, pct):
        return (name or "—") + (f"（{pct}%）" if pct != 100 else "")
    info(f"配置：范围 {cfg.get('scope', 'cjk')}，"
         f"中文字体 {fmt(cfg['font'], _scale(cfg, 'font_scale'))}，"
         f"英文字体 {fmt(cfg.get('font_latin'), _scale(cfg, 'font_scale_latin'))}，"
         f"模式 {cfg.get('mode', 'auto')}")
    info(f"代码块字体 {fmt(cfg.get('font_mono'), _scale(cfg, 'font_mono_scale'))}"
         f"，页面底色 {cfg.get('bg_color') or '—'}"
         f"，英文范围 {'仅正文' if cfg.get('latin_scope') == 'body' else '全部'}"
         f"，界面字号 {_scale(cfg, 'font_scale_ui')}%")


def cmd_doctor(_args):
    print(f"clfont doctor（目标：{APP}）")
    problems = 0

    version = claude_version()
    if version:
        ok(f"Claude.app 存在，版本 {version}")
    else:
        bad(f"未找到 {APP}")
        problems += 1

    j = journal_read()
    if j and not j.get("corrupt"):
        bad(f"存在未完成事务（{j.get('txn')} @ {j.get('time')}，"
            f"状态 {j.get('status')}）——跑 clfont uninstall 可修复")
        info("步骤记录：" + "; ".join(
            f"{s['step']}{'' if s.get('done') else '(未完成)'}"
            for s in j.get("steps", [])))
        problems += 1
    else:
        ok("无未完成事务")

    songti = [p for p in (
        Path("/System/Library/Fonts/Supplemental/Songti.ttc"),
        Path("/System/Library/Fonts/Songti.ttc"),
        Path.home() / "Library/Fonts/Songti.ttc") if p.exists()]
    if songti:
        ok(f"Songti SC 字体存在：{songti[0]}")
    else:
        bad("未找到 Songti.ttc（系统宋体），补丁后 CJK 可能落回默认 serif")
        problems += 1

    if claude_running():
        bad("Claude 正在运行（install/uninstall 前需退出，脚本会代为处理）")
    else:
        ok("Claude 未在运行")

    free = shutil.disk_usage(Path.home()).free / 1024 ** 3
    if free >= 3:
        ok(f"磁盘剩余 {free:.1f}GB（备份约需 1–2GB）")
    else:
        bad(f"磁盘剩余仅 {free:.1f}GB，可能不够备份")
        problems += 1
    good, detail = app_write_permitted()
    if good:
        ok("「App 管理」权限：可写入目标 app")
    else:
        bad(f"「App 管理」权限：无法写入 {APP}（{detail}）")
        info("请到「系统设置 → 隐私与安全性 → App 管理」为 Clfont"
             "（或从终端运行时的「终端」）打开开关")
        problems += 1

    good, detail = codesign_available()
    if good:
        ok(f"codesign 可用：{detail}")
    else:
        bad(f"codesign 不可用：{detail}。"
            "先运行 xcode-select --install，否则 install/uninstall 都无法完成，"
            "连回滚也签不了名")
        problems += 1

    backups = list_backups()
    info(f"备份目录 {DATA_DIR}：当前目标有 {len(backups)} 份备份")
    if version:
        team = signing_team()
        if team:
            ok(f"签名身份：TeamIdentifier={team}（原厂签名）")
        elif pristine_backup_for_current():
            info("签名身份：ad-hoc（已被 clfont 重签）。"
                 "当前版本有整包备份，clfont uninstall 可恢复原始签名")
        else:
            bad("签名身份：ad-hoc（已被 clfont 重签），且没有当前版本的整包备份，"
                "原始签名无法还原——需要重新下载安装 Claude 才能恢复")
            problems += 1
        if nested_entitlements_stripped():
            bad("Helper 权限：已被旧版重签名抹掉（Cowork、虚拟机等功能会不可用）")
            if pristine_backup_for_current():
                info("下次 clfont install 会自动从整包备份还原并修复")
            else:
                info("没有可用备份，需重新下载安装 Claude 才能修复")
            problems += 1
        else:
            ok("Helper 权限：完整")
    if CANON.exists():
        ok(f"工具固定位置已安装：{CANON}")
    else:
        info(f"工具尚未安装到 {CANON}（install 时会自动复制）")

    if version:
        if APP_DIR.exists():
            bad("存在 app/ 目录（旧机制残留）——当前 Claude 启用了 "
                "OnlyLoadAppFromAsar fuse，该目录会导致 app 无法启动，"
                "运行 clfont uninstall 清理")
            problems += 1
        if not ASAR.exists():
            bad("app.asar 缺失！运行 clfont uninstall 从整包备份恢复")
            problems += 1
        else:
            if is_patched():
                ok("已打补丁（asar 内检测到注入标记）")
            elif ASAR_BAK.exists():
                bad("app.asar.bak 存在但 asar 无补丁标记（半成品状态），"
                    "运行 clfont uninstall 可恢复")
                problems += 1
            else:
                ok("未打补丁（原始状态）")
            want, got = asar_header_hash(ASAR), plist_get_asar_hash()
            if want == got:
                ok("asar 完整性哈希与 Info.plist 匹配")
            else:
                bad("asar 完整性哈希与 Info.plist 不匹配——Claude 将无法启动！"
                    "跑 clfont uninstall 修复")
                problems += 1
        if sign_valid():
            ok("codesign 验证通过")
        else:
            bad("codesign 验证未通过——Claude 将无法启动！"
                "跑 clfont uninstall（会重签）")
            problems += 1

    print(f"\n{'✗ 发现 %d 个问题' % problems if problems else '✓ 一切正常'}")
    sys.exit(1 if problems else 0)


