def main():
    if sys.platform != "darwin":
        die("仅支持 macOS")
    ap = argparse.ArgumentParser(
        prog="clfont",
        description="Claude Desktop 中文字体补丁工具（中文→宋体，拉丁/代码不受影响）")
    ap.add_argument("--app", help=argparse.SUPPRESS)  # 测试用：指定 .app 副本
    sub = ap.add_subparsers(dest="cmd", required=True)

    p_install = sub.add_parser("install", help="打补丁（幂等，失败自动回滚）")
    p_install.add_argument("--scope", choices=["cjk", "latin", "both"],
                           help="替换哪种文字：cjk=中文，latin=英文，both=中英文")
    p_install.add_argument("--mode", choices=["auto", "brute"],
                           help="auto=改 CDS 字体变量（默认，拉丁不受影响）；"
                                "brute=额外加全局兜底规则（变量名不匹配时用）")
    p_install.add_argument("--scale", type=int, metavar="N",
                           help=f"中文字号百分比（{SCALE_MIN}–{SCALE_MAX}，默认 100）")
    p_install.add_argument("--scale-latin", type=int, metavar="N",
                           help=f"英文字号百分比（{SCALE_MIN}–{SCALE_MAX}，默认 100）")
    p_install.add_argument("--mono", metavar="FONT",
                           help="代码块字体（留空字符串表示不改）")
    p_install.add_argument("--mono-scale", type=int, metavar="N",
                           help=f"代码块字号百分比（{SCALE_MIN}–{SCALE_MAX}）")
    p_install.add_argument("--bg", metavar="#RRGGBB",
                           help="页面底色（留空字符串表示不改）")
    p_install.add_argument("--scale-ui", type=int, metavar="N",
                           help=f"界面字号百分比（{SCALE_MIN}–{SCALE_MAX}，默认 100）")
    p_install.add_argument("--latin-scope", choices=["all", "body"],
                           help="换英文时的范围：all=连界面一起换，body=只换正文")
    p_install.add_argument("-y", "--yes", action="store_true",
                           help="所有确认自动回答 yes")

    p_un = sub.add_parser("uninstall", help="完全还原")
    p_un.add_argument("-y", "--yes", action="store_true")

    sub.add_parser("status", help="显示当前状态")
    # 隐藏命令：打印将要注入的 CSS。供回归测试比对 Python 版与 Swift 版的输出，
    # 也方便排查「补丁装上了但没生效」时到底注入了什么。
    p_css = sub.add_parser("_css", help=argparse.SUPPRESS)
    p_css.add_argument("--scope", choices=["cjk", "latin", "both"])
    p_css.add_argument("--mode", choices=["auto", "brute"])
    p_css.add_argument("--scale", type=int)
    p_css.add_argument("--scale-latin", type=int)
    p_css.add_argument("--mono")
    p_css.add_argument("--mono-scale", type=int)
    p_css.add_argument("--bg")
    p_css.add_argument("--latin-scope", choices=["all", "body"])
    p_css.add_argument("--scale-ui", type=int)
    p_bk = sub.add_parser("backups", help="列出整包备份，可清理旧版本")
    p_bk.add_argument("--prune", action="store_true",
                      help="删除与当前版本不匹配的备份（那些已无法用于还原）")
    p_bk.add_argument("--purge", action="store_true",
                      help="删除当前目标的全部备份（含当前版本；用于彻底移除某个目标）")
    p_bk.add_argument("--all", action="store_true",
                      help="连同属于其他目标的备份一起列出/清理")
    p_bk.add_argument("-y", "--yes", action="store_true", help="不询问直接执行")
    sub.add_parser("doctor", help="环境自检")

    args = ap.parse_args()
    if args.app:
        set_app(args.app)
    def _sigterm(*_):
        raise KeyboardInterrupt("SIGTERM")
    signal.signal(signal.SIGTERM, _sigterm)
    L.open(args.cmd)
    {"install": cmd_install, "uninstall": cmd_uninstall,
     "status": cmd_status, "doctor": cmd_doctor,
     "backups": cmd_backups, "_css": cmd_css}[args.cmd](args)


if __name__ == "__main__":
    main()
