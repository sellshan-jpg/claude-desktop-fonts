def manual_restore_text():
    return f"""  首选（工具自救）：
    {CANON} uninstall
  或手动执行（注意：必须同步 Info.plist 的 asar 完整性哈希，否则 app 起不来）：
    cd "{RES}"
    rm -rf app app.asar.clfont-new*
    [ -f app.asar.bak ] && mv -f app.asar.bak app.asar
    H=$(python3 -c "import struct,hashlib;f=open('app.asar','rb');\\
_,_,_,jl=struct.unpack('<IIII',f.read(16));print(hashlib.sha256(f.read(jl)).hexdigest())")
